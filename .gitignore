# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ...but the vendored Unitree CRC libs are prebuilt binaries that MUST ship
# (pip-installing unitree_sdk2py from git drops them, breaking live control).
!third_party/unitree_sdk2_python/unitree_sdk2py/utils/lib/crc_amd64.so
!third_party/unitree_sdk2_python/unitree_sdk2py/utils/lib/crc_aarch64.so

# Virtual envs
.venv/
venv/
env/
.env

# Build / install artefacts
build/
dist/
*.egg-info/
.eggs/

# Vendored CycloneDDS is built from source per-machine — ship the source,
# never the build output (build/ is covered above; install/ is machine-specific).
third_party/cyclonedds/install/

# IDE / editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Notebooks
.ipynb_checkpoints/

# Local mesh / model caches the SDK auto-generates next to the bundled
# pre-built one. The shipped cache is checked in deliberately so first-
# clone IK init is instant; any *additional* caches users build go here.
# (Uncomment the line below if you decide NOT to ship the cache.)
# g1_inspire_sdk/_ik/*.pkl

# Rerun recordings
*.rrd
